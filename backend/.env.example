# Copy to .env and edit. Never commit real secrets.

APP_NAME="FORUM24 API"
ENVIRONMENT=development

# Local development uses SQLite so the API runs with no services.
# Production / docker-compose:
#   DATABASE_URL=postgresql+psycopg://forum24:forum24@localhost:5432/forum24
DATABASE_URL=sqlite+aiosqlite:///./forum24.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

ACCESS_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]

# Create demo content on startup when the database is empty.
SEED_ON_STARTUP=true

# Auto-publish approved articles when their scheduled slot passes.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Public URL prefix used when building download links.
PUBLIC_BASE_URL=http://localhost:8000
